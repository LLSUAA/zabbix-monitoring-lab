#!/bin/bash
echo "======= 第二步：安装Zabbix 6.0 监控系统（使用Nginx） ======="

# 设置密码变量（不使用特殊字符！）
MYSQL_ROOT_PASS="root123"
ZABBIX_DB_PASS="zabbix123"

# 1. 添加Zabbix仓库
wget -q https://repo.zabbix.com/zabbix/6.0/ubuntu/pool/main/z/zabbix-release/zabbix-release_6.0-4+ubuntu22.04_all.deb
sudo dpkg -i zabbix-release_6.0-4+ubuntu22.04_all.deb
sudo apt update
rm -f zabbix-release_6.0-4+ubuntu22.04_all.deb

# 2. 安装Zabbix组件
sudo apt install -y zabbix-server-mysql zabbix-frontend-php zabbix-sql-scripts zabbix-agent2

# 3. 创建Zabbix数据库和用户
echo "创建Zabbix数据库..."
sudo mysql -u root -p$MYSQL_ROOT_PASS <<EOF
CREATE DATABASE IF NOT EXISTS zabbix CHARACTER SET utf8mb4 COLLATE utf8mb4_bin;
CREATE USER IF NOT EXISTS 'zabbix'@'localhost' IDENTIFIED BY '$ZABBIX_DB_PASS';
GRANT ALL PRIVILEGES ON zabbix.* TO 'zabbix'@'localhost';
FLUSH PRIVILEGES;
SET GLOBAL log_bin_trust_function_creators = 1;
EOF

# 4. 导入数据库架构
echo "导入数据库架构..."
sudo zcat /usr/share/zabbix-sql-scripts/mysql/server.sql.gz | mysql -uzabbix -p$ZABBIX_DB_PASS zabbix

# 5. 恢复权限设置
sudo mysql -u root -p$MYSQL_ROOT_PASS -e "SET GLOBAL log_bin_trust_function_creators = 0;"

# 6. 配置Zabbix Server（已修复！包含必要的LogFile参数）
echo "配置Zabbix Server..."
sudo tee /etc/zabbix/zabbix_server.conf > /dev/null <<EOF
LogFile=/var/log/zabbix/zabbix_server.log
LogFileSize=0
PidFile=/run/zabbix/zabbix_server.pid
SocketDir=/run/zabbix
DBHost=localhost
DBName=zabbix
DBUser=zabbix
DBPassword=$ZABBIX_DB_PASS
Timeout=4
AlertScriptsPath=/usr/lib/zabbix/alertscripts
ExternalScripts=/usr/lib/zabbix/externalscripts
LogSlowQueries=3000
StatsAllowedIP=127.0.0.1
EOF

# 6.5 创建必要的运行时目录并设置权限（新增的关键步骤！）
echo "创建运行时目录并设置权限..."
sudo mkdir -p /run/zabbix /var/log/zabbix
sudo chown -R zabbix:zabbix /run/zabbix /var/log/zabbix
sudo chmod 755 /run/zabbix

# 7. 创建Zabbix专属Nginx配置（使用8080端口，避免与LNMP冲突）
sudo tee /etc/nginx/sites-available/zabbix > /dev/null <<'EOF'
server {
    listen 8080;
    server_name _;
    root /usr/share/zabbix;
    index index.php;
    
    location / {
        try_files $uri $uri/ /index.php?$args;
    }
    
    location ~ \.php$ {
        fastcgi_pass unix:/run/php/php8.1-fpm.sock;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }
}
EOF

# 8. 启用Zabbix站点（不删除默认站点，两者共存）
sudo ln -sf /etc/nginx/sites-available/zabbix /etc/nginx/sites-enabled/

# 9. PHP配置
sudo tee /etc/php/8.1/fpm/conf.d/99-zabbix.ini > /dev/null <<EOF
max_execution_time = 300
max_input_time = 300
memory_limit = 128M
post_max_size = 16M
upload_max_filesize = 2M
date.timezone = Asia/Shanghai
EOF

# 10. 设置权限
sudo chown -R www-data:www-data /usr/share/zabbix/

# 11. 重启服务
sudo systemctl restart php8.1-fpm
sudo nginx -t && sudo systemctl restart nginx
sudo systemctl restart zabbix-server zabbix-agent2
sudo systemctl enable zabbix-server zabbix-agent2

IP_ADDR=$(hostname -I | awk '{print $1}')
echo ""
echo "✅ Zabbix安装完成！"
echo "=========================================="
echo "LNMP测试页: http://$IP_ADDR"
echo "Zabbix监控: http://$IP_ADDR:8080/"
echo "Zabbix登录: Admin / zabbix"
echo "MySQL root密码: $MYSQL_ROOT_PASS"
echo "Zabbix数据库密码: $ZABBIX_DB_PASS"
echo "=========================================="
