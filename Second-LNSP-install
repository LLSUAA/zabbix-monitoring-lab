# 添加文件上传限制
echo "post_max_size = 32M" | sudo tee -a /etc/php/8.1/fpm/php.ini
echo "upload_max_filesize = 32M" | sudo tee -a /etc/php/8.1/fpm/php.ini
echo "max_file_uploads = 20" | sudo tee -a /etc/php/8.1/fpm/php.ini

# 复制到CLI配置
sudo cp /etc/php/8.1/fpm/php.ini /etc/php/8.1/cli/php.ini
sudo systemctl restart php8.1-fpm
sudo systemctl enable php8.1-fpm

echo "[8/9] 配置Nginx支持PHP..."
sudo tee /etc/nginx/sites-available/default > /dev/null <<'NGINX_CONFIG'
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    
    root /var/www/html;
    index index.php index.html index.htm;
    
    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;
    
    # 安全头
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
    
    location / {
        try_files $uri $uri/ =404;
    }
    
    # PHP处理
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.1-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
        
        # 额外的PHP参数
        fastcgi_param PHP_VALUE "
            post_max_size=32M
            upload_max_filesize=32M
            max_execution_time=600
            memory_limit=256M
            date.timezone=Asia/Shanghai
        ";
    }
    
    # 禁止访问隐藏文件
    location ~ /\.(ht|git|svn) {
        deny all;
    }
    
    # 静态文件缓存
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
NGINX_CONFIG

# 创建Web根目录
sudo mkdir -p /var/www/html
sudo chown -R www-data:www-data /var/www
sudo chmod -R 755 /var/www

echo "[9/9] 创建测试页面并验证..."
