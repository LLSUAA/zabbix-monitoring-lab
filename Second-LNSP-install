#!/bin/bash
# 2_install_lnmp_fixed.sh
echo "=========================================="
echo "安装LNMP环境 (Nginx + MySQL + PHP)"
echo "=========================================="

set -e

# 配置变量
MYSQL_ROOT_PASS="root123"
TIMEZONE="Asia/Shanghai"

# 记录开始时间
START_TIME=$(date +%s)

echo "[1/9] 更新系统并安装必要工具..."
sudo apt update
sudo apt upgrade -y
sudo apt install -y \
    software-properties-common \
    lsb-release \
    ca-certificates \
    wget \
    curl \
    gnupg \
    debconf-utils

echo "[2/9] 预配置MySQL密码（关键步骤）..."
# 提前设置MySQL的root密码，避免交互式提示
echo "mysql-server mysql-server/root_password password ${MYSQL_ROOT_PASS}" | sudo debconf-set-selections
echo "mysql-server mysql-server/root_password_again password ${MYSQL_ROOT_PASS}" | sudo debconf-set-selections
echo "mysql-server-8.0 mysql-server/root_password password ${MYSQL_ROOT_PASS}" | sudo debconf-set-selections
echo "mysql-server-8.0 mysql-server/root_password_again password ${MYSQL_ROOT_PASS}" | sudo debconf-set-selections
echo "✅ MySQL密码预配置完成"

echo "[3/9] 安装MySQL 8.0..."
sudo apt install -y mysql-server
sudo systemctl start mysql
sudo systemctl enable mysql

# 验证MySQL安装
echo "等待MySQL启动..."
sleep 5

# 检查MySQL服务状态
if ! systemctl is-active --quiet mysql; then
    echo "⚠️ MySQL服务未运行，尝试启动..."
    sudo systemctl restart mysql
    sleep 3
fi

echo "[4/9] 验证和加固MySQL密码..."
# 多种方法确保密码设置正确
echo "尝试方法1：使用mysqladmin..."
sudo mysqladmin -u root password ${MYSQL_ROOT_PASS} 2>/dev/null || true

echo "尝试方法2：直接SQL修改..."
sudo mysql -uroot <<MYSQL_SCRIPT 2>/dev/null || true
ALTER USER 'root'@'localhost' IDENTIFIED WITH mysql_native_password BY '${MYSQL_ROOT_PASS}';
FLUSH PRIVILEGES;
MYSQL_SCRIPT

# 最终验证
echo "测试MySQL连接..."
if mysql -u root -p${MYSQL_ROOT_PASS} -e "SELECT 1;" >/dev/null 2>&1; then
    echo "✅ MySQL root密码验证成功: ${MYSQL_ROOT_PASS}"
else
    echo "❌ MySQL密码设置失败，尝试最终修复..."
    
    # 紧急修复方案
    sudo systemctl stop mysql
    sudo mysqld_safe --skip-grant-tables &
    sleep 3
    
    mysql <<EMERGENCY_FIX
USE mysql;
UPDATE user SET plugin='mysql_native_password' WHERE User='root';
UPDATE user SET authentication_string=PASSWORD('${MYSQL_ROOT_PASS}') WHERE User='root';
FLUSH PRIVILEGES;
EMERGENCY_FIX
    
    sudo pkill mysqld
    sleep 2
    sudo systemctl start mysql
    sleep 3
    
    # 再次验证
    if mysql -u root -p${MYSQL_ROOT_PASS} -e "SELECT 1;" >/dev/null 2>&1; then
        echo "✅ MySQL密码修复成功"
    else
        echo "⚠️ MySQL仍有问题，但继续安装..."
    fi
fi

echo "[5/9] 安装Nginx..."
sudo apt install -y nginx
# 确保Nginx配置目录存在
sudo mkdir -p /etc/nginx/sites-available /etc/nginx/sites-enabled
sudo systemctl start nginx
sudo systemctl enable nginx

# 检查端口冲突
echo "检查端口冲突..."
if sudo netstat -tlnp | grep -E ":80\s.*nginx" >/dev/null; then
    echo "✅ Nginx已在端口80运行"
else
    echo "⚠️ Nginx端口可能被占用，检查中..."
    sudo lsof -i :80 || true
fi

echo "[6/9] 添加PHP仓库并安装PHP 8.1..."
sudo add-apt-repository -y ppa:ondrej/php
sudo apt update
sudo apt install -y \
    php8.1-fpm \
    php8.1-mysql \
    php8.1-cli \
    php8.1-curl \
    php8.1-gd \
    php8.1-mbstring \
    php8.1-xml \
    php8.1-bcmath \
    php8.1-zip \
    php8.1-opcache \
    php8.1-ldap

echo "[7/9] 配置PHP..."
sudo tee /etc/php/8.1/fpm/php.ini > /dev/null <<PHPINI
